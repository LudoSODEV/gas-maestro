{
	"name": "gas-maestro",
	"version": "1.0.0",
	"description": "Google Apps Script Vue 3 Web App for Gas Maestro",
	"main": "index.js",
	"scripts": {
		"dev": "vite frontend",
		"build:backend": "esbuild src/Maestro.ts --bundle --platform=neutral --target=es2022 --outfile=dist/code.js",
		"build:frontend": "vue-tsc -p frontend/tsconfig.json --noEmit && vite build",
		"build:manifest": "node -e \"const fs = require('fs'); fs.copyFileSync('src/appsscript.json', 'dist/appsscript.json');\"",
		"build": "npm run build:frontend && npm run build:backend && npm run build:manifest",
		"push": "npm run build && clasp push",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"vue": "^3.5.44"
	},
	"devDependencies": {
		"@mermaid-js/mermaid-cli": "^12.0.0",
		"@types/google-apps-script": "^2.0.15",
		"@vitejs/plugin-vue": "^5.2.1",
		"typescript": "^6.0.3",
		"vite": "^6.0.0",
		"vite-plugin-singlefile": "^2.2.0",
		"vue-tsc": "^3.3.14"
	}
}
